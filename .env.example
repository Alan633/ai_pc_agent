TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.5-9b-16k
# Ollama OpenAI-compatible 接口；先运行 scripts/setup_ollama_qwen16k.bat 创建 16K 上下文模型
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MAX_STEPS=15
CONFIRM_TIMEOUT_SECONDS=120

# 点字成金自动游戏
GAME_VISION_MODEL=qwen3.5-9b-16k
GAME_VISION_BASE_URL=http://127.0.0.1:11434/v1
GAME_WINDOW_TITLE=欢乐斗地主
GAME_ACTION_INTERVAL_SECONDS=1.5
GAME_MIN_CARD_CONFIDENCE=0.72
GAME_MIN_EVENT_CONFIDENCE=0.80
# true：固定页面/回合状态优先用 OpenCV，本地 Qwen 只负责牌面和异常页面
GAME_FAST_VISION=true

# 出牌决策：rule=纯规则，ev=Python EV/Monte Carlo，hybrid=Python EV + 本地 Qwen Top-N 重排
GAME_DECISION_MODE=hybrid
GAME_DECISION_MODEL=qwen3.5-9b-16k
GAME_DECISION_BASE_URL=http://127.0.0.1:11434/v1
# 本地模型重排最多允许 4 秒；失败/超时自动回退 Python EV
GAME_DECISION_TIMEOUT_SECONDS=4.0
GAME_DECISION_TOP_N=4
GAME_DECISION_MIN_CONFIDENCE=0.55
# Qwen 若选择比最高 EV 低太多的候选，强制回退 EV
GAME_HYBRID_MAX_EV_DROP=18.0

# 默认 false：一局结束后停止，避免自动消耗下一局豆子
GAME_AUTO_NEXT_ROUND=false

# 点字成金牌局采集
GAME_RECORD_FPS=6
GAME_RECORD_ARCHIVE_FPS=2
GAME_RECORD_DIFF_THRESHOLD=0.028
GAME_RECORD_JPEG_QUALITY=78


# Steam《Balatro / 小丑牌》自动游戏
BALATRO_VISION_MODEL=qwen3.5-9b-16k
BALATRO_VISION_BASE_URL=http://127.0.0.1:11434/v1
BALATRO_WINDOW_TITLE=Balatro
BALATRO_ACTION_INTERVAL_SECONDS=1.2
# false：Run 结束后停止，防止自动开启下一局
BALATRO_AUTO_NEXT_RUN=false
# 商店至少保留 $5
BALATRO_RESERVE_MONEY=5


# Balatro 决策：python=仅Python候选；hybrid=Python候选 + 本地Qwen长期策略重排
BALATRO_DECISION_MODE=hybrid
BALATRO_DECISION_MODEL=qwen3.5-9b-16k
BALATRO_DECISION_BASE_URL=http://127.0.0.1:11434/v1
# 本地策略模型超时后自动回退 Python，不阻塞游戏
BALATRO_DECISION_TIMEOUT_SECONDS=6.0
# 只把前 N 个 Python 合法候选交给 Qwen，模型不能创造新动作
BALATRO_DECISION_TOP_N=6
BALATRO_DECISION_MIN_CONFIDENCE=0.55
