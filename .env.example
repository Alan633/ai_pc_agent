TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.5-9b-16k
# Ollama OpenAI-compatible 接口；先运行 scripts/setup_ollama_qwen16k.bat 创建 16K 上下文模型
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MAX_STEPS=15
CONFIRM_TIMEOUT_SECONDS=120

# 点字成金自动游戏
GAME_VISION_MODEL=qwen3.5-9b-16k
GAME_VISION_BASE_URL=http://127.0.0.1:11434/v1
GAME_WINDOW_TITLE=欢乐斗地主
GAME_ACTION_INTERVAL_SECONDS=1.5
GAME_MIN_CARD_CONFIDENCE=0.72
GAME_MIN_EVENT_CONFIDENCE=0.80
# true：固定页面/回合状态优先用 OpenCV，本地 Qwen 只负责牌面和异常页面
GAME_FAST_VISION=true
# 默认 false：一局结束后停止，避免自动消耗下一局豆子
GAME_AUTO_NEXT_ROUND=false

# 点字成金牌局采集
GAME_RECORD_FPS=6
GAME_RECORD_ARCHIVE_FPS=2
GAME_RECORD_DIFF_THRESHOLD=0.028
GAME_RECORD_JPEG_QUALITY=78
